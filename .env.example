# Copiar a .env y completar antes de `docker compose up`

# Versiones de imágenes
ELASTIC_VERSION=8.13.4
WAZUH_VERSION=4.7.5
VELOCIRAPTOR_VERSION=latest
THEHIVE_VERSION=5.3
N8N_VERSION=latest

# TheHive
THEHIVE_SECRET=change-me-a-un-secreto-largo-y-aleatorio

# n8n
N8N_USER=admin
N8N_PASSWORD=change-me
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Bogota

# Fase 2 — agente de triage
OLLAMA_MODEL=qwen3
CHROMA_COLLECTION=aigis_kb
# CHROMA_PORT_HOST=8010   # usado por scripts/seed_kb.py corriendo desde el host

# Workflow n8n/workflows/wazuh-triage-to-thehive.json — se leen dentro de n8n
# vía $env.*, el workflow no los hardcodea.
# TheHive: Organización > tu usuario > "Create API key"
THEHIVE_API_KEY=
# Slack: Incoming Webhook de tu workspace (app "Incoming Webhooks")
SLACK_WEBHOOK_URL=
# Telegram: token de @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram: chat_id del canal/chat on-call (solo alta severidad)
TELEGRAM_CHAT_ID_ONCALL=

# Fase 3 — honeypot Cowrie en AWS (infra/aws-honeypot/), servicio honeypot-puller
# Completar con los outputs de `terraform output` después de `terraform apply`.
# Credenciales del usuario IAM "puller" (solo lectura), no las del rol del EC2.
HONEYPOT_S3_BUCKET=
AWS_REGION=us-east-1
HONEYPOT_AWS_ACCESS_KEY_ID=
HONEYPOT_AWS_SECRET_ACCESS_KEY=

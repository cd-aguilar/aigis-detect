{
  "name": "Aigis-Detect - Wazuh -> Agente -> TheHive/Slack/Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "n1",
      "name": "Cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://elasticsearch:9200/wazuh-alerts-*/_search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"query\": {\n    \"range\": { \"@timestamp\": { \"gte\": \"now-16m\" } }\n  },\n  \"size\": 5,\n  \"sort\": [{ \"@timestamp\": \"asc\" }]\n}",
        "options": {}
      },
      "id": "n2",
      "name": "Buscar alertas nuevas en Elastic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "hits.hits",
        "options": {}
      },
      "id": "n3",
      "name": "Separar alertas",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": 5
      },
      "id": "n15",
      "name": "Limitar items por ejecución",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "n16",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {},
      "id": "n18",
      "name": "Fin del ciclo",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        -256
      ]
    },
    {
      "parameters": {},
      "id": "n17",
      "name": "Fin - severidad normal",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2640,
        -16
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "value",
        "key": "=aigis:dedup:{{$json._id}}",
        "options": {}
      },
      "id": "n4",
      "name": "Redis - ya procesada?",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "credentials": {
        "redis": {
          "id": "VCpEBE6zYDlSgNTQ",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-empty",
              "leftValue": "={{$json.value}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          }
        },
        "options": {}
      },
      "id": "n5",
      "name": "Ya procesada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "=aigis:dedup:{{$('Separar alertas').item.json._id}}",
        "value": "1",
        "expire": true,
        "ttl": 86400
      },
      "id": "n6",
      "name": "Redis - marcar procesada",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1104,
        -128
      ],
      "credentials": {
        "redis": {
          "id": "VCpEBE6zYDlSgNTQ",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "alert_id",
              "type": "string",
              "value": "={{$('Separar alertas').item.json._id}}"
            },
            {
              "id": "a2",
              "name": "rule_id",
              "type": "string",
              "value": "={{$('Separar alertas').item.json._source.rule?.id || ''}}"
            },
            {
              "id": "a3",
              "name": "rule_description",
              "type": "string",
              "value": "={{$('Separar alertas').item.json._source.rule?.description || ''}}"
            },
            {
              "id": "a4",
              "name": "timestamp",
              "type": "string",
              "value": "={{$('Separar alertas').item.json._source['@timestamp']}}"
            },
            {
              "id": "a5",
              "name": "agent_name",
              "type": "string",
              "value": "={{$('Separar alertas').item.json._source.agent?.name || ''}}"
            },
            {
              "id": "a6",
              "name": "raw",
              "type": "object",
              "value": "={{$('Separar alertas').item.json._source}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "Armar AlertInput",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1328,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent:8080/triage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ alert_id: $json.alert_id, rule_id: $json.rule_id, rule_description: $json.rule_description, timestamp: $json.timestamp, agent_name: $json.agent_name, raw: $json.raw }) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "n8",
      "name": "Llamar agente /triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1552,
        -128
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "alert_id",
              "type": "string",
              "value": "={{$('Armar AlertInput').item.json.alert_id}}"
            },
            {
              "id": "b2",
              "name": "rule_description",
              "type": "string",
              "value": "={{$('Armar AlertInput').item.json.rule_description}}"
            },
            {
              "id": "b3",
              "name": "verdict",
              "type": "string",
              "value": "={{$json.verdict}}"
            },
            {
              "id": "b4",
              "name": "severity",
              "type": "string",
              "value": "={{$json.severity}}"
            },
            {
              "id": "b5",
              "name": "mitre_technique",
              "type": "string",
              "value": "={{$json.mitre_technique}}"
            },
            {
              "id": "b6",
              "name": "explanation",
              "type": "string",
              "value": "={{$json.explanation}}"
            },
            {
              "id": "b7",
              "name": "suggested_action",
              "type": "string",
              "value": "={{$json.suggested_action}}"
            },
            {
              "id": "b8",
              "name": "thehive_severity",
              "type": "number",
              "value": "={{ ({low:1, medium:2, high:3, critical:4})[$json.severity] || 2 }}"
            },
            {
              "id": "b9",
              "name": "is_high_severity",
              "type": "boolean",
              "value": "={{ ['high','critical'].includes($json.severity) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "n9",
      "name": "Mapear severidad TheHive",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1760,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://thehive:9000/api/v1/alert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.THEHIVE_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'external', source: 'aigis-detect', sourceRef: $json.alert_id, title: ($json.rule_description || 'Alerta Wazuh') + ' — ' + $json.verdict, description: $json.explanation + '\\n\\nAcción sugerida: ' + $json.suggested_action, severity: $json.thehive_severity, tags: ['aigis-detect', 'verdict:' + $json.verdict, $json.mitre_technique ? ('mitre:' + $json.mitre_technique) : 'mitre:unknown'], tlp: 2, pap: 2 }) }}",
        "options": {}
      },
      "id": "n10",
      "name": "Crear alerta en TheHive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1984,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '*Aigis-Detect* — ' + $('Mapear severidad TheHive').item.json.verdict + ' (' + $('Mapear severidad TheHive').item.json.severity + ')\\nAlerta: ' + $('Mapear severidad TheHive').item.json.rule_description + '\\nTécnica: ' + ($('Mapear severidad TheHive').item.json.mitre_technique || 'N/A') + '\\n' + $('Mapear severidad TheHive').item.json.explanation }) }}",
        "options": {}
      },
      "id": "n11",
      "name": "Slack - log completo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2208,
        -128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-high",
              "leftValue": "={{$('Mapear severidad TheHive').item.json.is_high_severity}}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n12",
      "name": "Es alta severidad?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2432,
        -128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID_ONCALL, text: '🚨 Aigis-Detect — ' + ($('Mapear severidad TheHive').item.json.severity || '').toUpperCase() + '\\n' + $('Mapear severidad TheHive').item.json.rule_description + '\\nVeredicto: ' + $('Mapear severidad TheHive').item.json.verdict + '\\nTécnica: ' + ($('Mapear severidad TheHive').item.json.mitre_technique || 'N/A') + '\\n' + $('Mapear severidad TheHive').item.json.suggested_action }) }}",
        "options": {}
      },
      "id": "n13",
      "name": "Telegram - alta severidad",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        -224
      ]
    },
    {
      "parameters": {},
      "id": "n14",
      "name": "Fin - alerta ya procesada",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1104,
        144
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5679/webhook/soc-alert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ alert_id: $('Mapear severidad TheHive').item.json.alert_id, alert_raw: '[Wazuh ALERT] Host: ' + ($('Armar AlertInput').item.json.agent_name || 'unknown') + '\\nRule: ' + $('Mapear severidad TheHive').item.json.rule_description + '\\nAigis-Detect verdict: ' + $('Mapear severidad TheHive').item.json.verdict + ' (severity: ' + $('Mapear severidad TheHive').item.json.severity + ')' + '\\nMITRE: ' + ($('Mapear severidad TheHive').item.json.mitre_technique || 'unknown') + '\\nExplanation: ' + $('Mapear severidad TheHive').item.json.explanation + '\\nRaw event: ' + JSON.stringify($('Armar AlertInput').item.json.raw) }) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "n24",
      "name": "Escalar a agent-orchestrator-soc (Tier 2)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        20
      ],
      "continueOnFail": true
    }
  ],
